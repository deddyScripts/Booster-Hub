        for k, b in pairs(buttons) do
            b.BackgroundColor3 = (k == name) and Color3.fromRGB(0, 140, 220) or Color3.fromRGB(28, 44, 76)
            b.TextColor3 = (k == name) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 230, 255)
